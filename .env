HOST=127.0.0.1
PORT=3000
AGNES_API_KEY=sk-3mkap6TRWDxPLgv0y8nrm5L6j8e1atMxQkadbyUBNIeDwKfv
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_TIMEOUT_MS=240000
# Per-attempt ceilings; a legacy 240s timeout no longer means 240s for text.
AGNES_TEXT_TIMEOUT_MS=90000
AGNES_VISION_TIMEOUT_MS=120000
AGNES_RETRIES=1
AGNES_MIN_INTERVAL_MS=3000
# Optional path to a Python interpreter / ffmpeg binary. Empty = auto.
PYTHON_PATH=
FFMPEG_PATH=
# Optional publicly accessible base URL for AI annotation of uploaded images.
PUBLIC_BASE_URL=
MAX_UPLOAD_MB=40

# Base64 output / input tested with supplied account; works for local uploads.
AGNES_VISION_INPUT=data_uri

# Optional custom Chrome executable for the desktop launcher. Empty = auto-detect.
CHROME_PATH=

# Pause AFTER a scene finishes, before the next scene starts.
AGNES_SCENE_DELAY_MIN_MS=1000
AGNES_SCENE_DELAY_MAX_MS=3000
