{
  "name": "whiteboard-studio",
  "version": "2.2.2",
  "private": true,
  "description": "Whiteboard video studio with scene planning, external image prompts and offline Piper narration",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test tests/*.test.js",
    "test:render": "node tests/render-smoke.mjs",
    "test:api": "node tests/api-smoke.mjs",
    "setup:tts": "node scripts/setup-tts.mjs",
    "test:tts": "node tests/piper-smoke.mjs",
    "test:features": "node tests/features-smoke.mjs",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/build-windows.ps1",
    "test:background": "node tests/background-render-smoke.mjs",
    "test:render-progress": "node tests/render-progress-smoke.mjs",
    "build:mac": "node desktop/build-macos.mjs",
    "setup:vieneu": "node scripts/setup-vieneu.mjs",
    "test:formats": "python tests/formats-render200.py",
    "test:vieneu-adapter": "python tests/vieneu-adapter200.py",
    "test:offline-vieneu": "node tests/offline-vieneu-smoke.mjs",
    "test:local-regions": "node tests/local-regions-smoke.mjs",
    "test:multi-region": "python tests/multi-region-render.py"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.34.5"
  }
}
